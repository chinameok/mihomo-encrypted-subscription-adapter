<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.mihomo-subscription-adapter</string>
	<key>ProgramArguments</key>
	<array>
		<string>__ADAPTER_PATH__</string>
		<string>refresh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<string>MEOK_SUBSCRIPTION_ADAPTER_DIR</string>
		<string>__RUNTIME_DIR__</string>
		<string>MEOK_MIHOMO_CONTROLLER_URL</string>
		<string>http://127.0.0.1:19090</string>
		<string>MEOK_MIHOMO_PROVIDER_NAME</string>
		<string>meok-subscription</string>
	</dict>
	<key>StartInterval</key>
	<integer>21600</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>__RUNTIME_DIR__/adapter.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__RUNTIME_DIR__/adapter.stderr.log</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
</dict>
</plist>
